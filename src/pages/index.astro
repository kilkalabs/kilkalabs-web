---
import '../styles/custom.css';

const title = 'Made by KilkaLabs — Apps for connection, play & everyday life';
const description = 'Discover In The Mood for couples, Letterwright for thoughtful word play, and Workmark, coming soon for Mac. Explore apps made by KilkaLabs.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'KilkaLabs',
  url: 'https://kilkalabs.com/',
  logo: 'https://kilkalabs.com/images/logo.webp',
  email: 'info@kilkalabs.com',
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: 'support@kilkalabs.com' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://kilkalabs.com/" />
    <meta name="theme-color" content="#243dab" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://kilkalabs.com/" />
    <meta property="og:site_name" content="KilkaLabs" />
    <meta property="og:image" content="https://kilkalabs.com/images/logo.webp" />
    <meta property="og:image:alt" content="KilkaLabs" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://kilkalabs.com/images/logo.webp" />
    <link rel="icon" type="image/webp" href="/images/logo.webp" />
    <link rel="preload" href="/fonts/manrope-extrabold.ttf" as="font" type="font/ttf" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="KilkaLabs home">KilkaLabs<span aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        <a href="#apps">Our apps</a>
        <a href="#support">Support</a>
      </nav>
    </header>
    <main id="main-content">
      <section class="intro shell" aria-labelledby="page-title">
        <h1 id="page-title">Small apps.<br /><span>Time well spent.</span></h1>
        <p>For time together.<br />For a little time to yourself.</p>
      </section>
      <nav class="app-index shell" id="apps" aria-label="Explore our apps">
        <a href="#in-the-mood">In The Mood <span>iPhone</span></a>
        <a href="#letterwright">Letterwright <span>iPhone</span></a>
        <a href="#workmark">Workmark <span>Mac · Coming soon</span></a>
      </nav>
      <section class="release mood" id="in-the-mood" aria-labelledby="mood-title">
        <div class="shell mood-layout">
          <div class="release-copy">
            <h2 id="mood-title">In The <br />Mood<span class="title-dot">.</span></h2>
            <p class="release-line">A little closer.<br />On the same wavelength.</p>
            <p class="description">A private app for couples to share how they feel and find the right moment to connect. Less guessing. More understanding.</p>
            <div class="actions">
              <a class="button" href="https://getinthemood.app/">Visit website <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
              <a class="download" href="https://apps.apple.com/app/id6744419061" aria-label="Get In The Mood on the App Store">Get it for iPhone</a>
            </div>
          </div>
          <figure class="mood-preview preview">
            <img src="/images/in-the-mood.webp" alt="In The Mood: share your mood and see when you and your partner feel the same way." width="1536" height="1024" fetchpriority="high" />
            <figcaption>Different moods. A shared connection.</figcaption>
          </figure>
        </div>
      </section>
      <section class="release letter" id="letterwright" aria-labelledby="letter-title">
        <div class="shell letter-layout">
          <div class="release-copy">
            <h2 id="letter-title">Letterwright<span class="title-dot">.</span></h2>
            <p class="release-line">One move.<br />A whole new possibility.</p>
            <p class="description">Swap neighbouring letters. Uncover words. Make every move count. A thoughtful word-grid game for iPhone, with no timer to rush you.</p>
            <div class="actions">
              <a class="button" href="https://letterwright.kilkalabs.com/">Visit website <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
              <a class="download" href="https://apps.apple.com/app/id6811364562" aria-label="Get Letterwright on the App Store">Get it for iPhone</a>
            </div>
            <p class="app-note">No ads. No account. Just the next word.</p>
          </div>
          <figure class="letter-preview preview">
            <img src="/images/letterwright.webp" alt="Letterwright's letter grid during a game, with neighbouring tiles ready to swap." width="600" height="1304" loading="lazy" />
            <figcaption>A quiet moment. A good word.</figcaption>
          </figure>
        </div>
      </section>
      <section class="release work" id="workmark" aria-labelledby="work-title">
        <div class="shell">
          <div class="work-heading">
            <h2 id="work-title">Workmark<span class="title-dot">.</span></h2>
            <span class="availability">Coming soon for Mac</span>
          </div>
          <div class="work-layout">
            <div class="release-copy">
              <p class="release-line">Your week.<br />Clearly marked.</p>
              <p class="description">A personal record of your office time, recorded when your Mac connects to your chosen office Wi-Fi. Your record stays on your Mac—not on an employer’s dashboard.</p>
              <div class="actions">
                <a class="button" href="https://workmark.kilkalabs.com/">Visit website <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
              </div>
              <p class="app-note">macOS 14 Sonoma or later.<br />A personal record, not proof of attendance.</p>
            </div>
            <figure class="work-preview preview">
              <img src="/images/workmark.webp" alt="Workmark's calendar with recorded office days and personal goals. Preview uses demo data." width="1500" height="1065" loading="lazy" />
              <figcaption>App preview · Demo data</figcaption>
            </figure>
          </div>
        </div>
      </section>
      <section class="support shell" id="support" aria-labelledby="support-title">
        <h2 id="support-title">A question?<br />We’re here.</h2>
        <div class="contact-details">
          <div>
            <h3>App support</h3>
            <a href="mailto:support@kilkalabs.com">support@kilkalabs.com</a>
            <p>Tell us which app you’re using, your device, and what happened. A little detail goes a long way.</p>
          </div>
          <div>
            <h3>Everything else</h3>
            <a href="mailto:info@kilkalabs.com">info@kilkalabs.com</a>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer shell">
      <a class="wordmark" href="/">KilkaLabs<span aria-hidden="true">.</span></a>
      <p>Made by KilkaLabs.</p>
      <p>&copy; {new Date().getFullYear()} KilkaLabs. All rights reserved.</p>
    </footer>
    <script src="../scripts/main.js"></script>
  </body>
</html>
